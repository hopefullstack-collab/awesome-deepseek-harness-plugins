{
  "$schema": "node_modules/wrangler/config-schema.json",
  // TODO: rename Worker for the company Cloudflare account if desired.
  "name": "company-store",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  // PLACEHOLDER hosts — replace with the real public HTTPS domains before
  // deploy. Keep all three entries; dropping one unbinds that custom domain.
  "routes": [
    {
      "pattern": "plugins.company.example",
      "custom_domain": true
    },
    {
      "pattern": "www.plugins.company.example",
      "custom_domain": true
    },
    {
      "pattern": "api.plugins.company.example",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "GITHUB_TOKEN",
      "INSTALL_CLIENT_HASH_SECRET",
      "CATALOG_SYNC_TOKEN",
      "GITHUB_OAUTH_CLIENT_ID",
      "GITHUB_OAUTH_CLIENT_SECRET"
    ]
  },
  "vars": {
    // 逗号分隔的 GitHub login，可以删社区里任何人的内容。留空表示只有作者
    // 能删自己的。COMMUNITY_DEV_LOGIN 故意不在这里 —— 见 apps/community/README.md。
    "COMMUNITY_ADMIN_LOGINS": "",
    // Company fork: GitHub topic whole-network scan OFF by default.
    // Set to "1" only if you intentionally want topic auto-discovery again.
    "TOPIC_DISCOVERY_ENABLED": "0"
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "CATALOG_CACHE",
      // TODO: create KV namespace in the company Cloudflare account and paste id.
      "id": "00000000000000000000000000000000"
    }
  ],
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      // TODO: create D1 database in the company account and paste name/id.
      "database_name": "company-store-catalog",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_STATS",
        "class_name": "LiveStats"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiveStats"]
    }
  ],
  "triggers": {
    // Topic discovery crons stay empty while TOPIC_DISCOVERY_ENABLED=0.
    // Re-enable upstream schedules only after flipping the var and reviewing ops.
    "crons": []
  },
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 10000
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01
    },
    "traces": {
      "enabled": false
    }
  }
}
