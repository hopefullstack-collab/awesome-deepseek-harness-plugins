+        suppliedUrl.protocol !== 'https:'
+        || suppliedUrl.hostname.toLowerCase() !== 'github.com'
+        || suppliedUrl.username
+        || suppliedUrl.password
+        || suppliedUrl.search
+        || suppliedUrl.hash
